# ─────────────────────────────────────────────────────────────
# 站内知识库问答（检索 + 大模型润色）
# 不填 LLM_API_KEY 也能跑：会自动降级为「知识库原文摘录」模式
# ─────────────────────────────────────────────────────────────

# 任意 OpenAI 兼容服务都可以，下面是 DeepSeek 的示例
# DeepSeek:  https://api.deepseek.com/v1                      模型 deepseek-chat
# 阿里百炼:  https://dashscope.aliyuncs.com/compatible-mode/v1 模型 qwen-plus
# 月之暗面:  https://api.moonshot.cn/v1                        模型 moonshot-v1-8k
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ─────────────────────────────────────────────────────────────
# 访客留言（Resend 邮件服务）
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
CONTACT_FROM=网站留言 <contact@zhengyun.online>
CONTACT_TO=zhengyun_0629@qq.com

# ─────────────────────────────────────────────────────────────
# 跨域白名单（同域部署可留空，多个用英文逗号分隔）
# ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=

# 运行时端口（Nginx 反代到这里）
PORT=3000

# ─────────────────────────────────────────────────────────────
# 浏览次数统计（/api/visit）
# 自建服务器留空即可：计数写入应用目录 data/visits.json
# Vercel 等无盘环境填自建服务器地址，函数会把请求转发过去，
# 这样两个站点共享同一份真实数据。留空且检测到 VERCEL 时
# 默认转发到 http://43.142.33.191
# ─────────────────────────────────────────────────────────────
VISIT_UPSTREAM=
